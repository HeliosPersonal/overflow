<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Do NOT enable CentralPackageTransitivePinningEnabled here. Several PackageVersion
         entries below have no matching PackageReference and are inert by design; the flag
         turns every one of them into a hard pin on somebody else's transitive dependency.
         Doing that split the Roslyn graph (Workspaces.MSBuild 5.9.0 against CodeAnalysis
         5.0.0) and every Wolverine service crashed on startup unable to load
         Microsoft.CodeAnalysis.Workspaces. To force a transitive version, add an explicit
         PackageReference in the one project that needs it instead. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommandFlow" Version="1.0.4" />
    <PackageVersion Include="CommandFlow.DependencyInjection" Version="1.0.4" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.1-preview.1.26506.6" />
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Yarp" Version="13.6.1" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="Aspire.Keycloak.Authentication" Version="13.6.1-preview.1.26506.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="FluentEmail.Core" Version="3.0.2" />
    <PackageVersion Include="FluentEmail.Mailgun" Version="3.0.2" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="Refit" Version="10.2.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="10.2.0" />
    <PackageVersion Include="Infisical.Sdk" Version="3.0.4" />
    <!-- Pulled in by WolverineFx.Marten 5.21.0 (which only floors it at 8.25.0).
         8.37.0+ fixes the regConfig full-text-search SQL injection (CVE-2026-45288).
         The LINQ dictionary-indexer injection (CVE-2026-75513) is only fixed in 9.13.0+,
         which requires the WolverineFx 6 major — see docs/PENDING_MAJOR_UPGRADES.md. -->
    <PackageVersion Include="Marten" Version="8.38.2" />
    <!-- Transitive via Aspire.Hosting.AppHost; 2.5.303+ fixes the deserialization DoS (CVE-2026-92707). -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.0-beta.1" />
    <PackageVersion Include="Polly" Version="8.8.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Typesense" Version="8.5.0" />
    <PackageVersion Include="WolverineFx" Version="5.21.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="5.21.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="5.21.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="5.21.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="5.21.0" />
  </ItemGroup>
</Project>