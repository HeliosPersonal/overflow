{
  "name": "overflow-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -e .env.development.local -- next dev --hostname 0.0.0.0",
    "dev:staging": "dotenv -e .env.staging -e .env.staging.local -- next dev",
    "dev:production": "dotenv -e .env.production -e .env.production.local -- next dev",
    "build": "next build",
    "build:staging": "dotenv -e .env.staging -e .env.staging.local -- next build",
    "build:production": "dotenv -e .env.production -e .env.production.local -- next build",
    "start": "next start",
    "start:staging": "dotenv -e .env.staging -e .env.staging.local -- next start",
    "start:production": "dotenv -e .env.production -e .env.production.local -- next start",
    "lint": "eslint"
  },
